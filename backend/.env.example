PORT=3001

# ── AI Provider (choose ONE — all use same OpenAI SDK) ──────────────────────
# Option A: OpenAI (best quality, ~$0.001/request)
OPENAI_API_KEY=sk-your-openai-key-here

# Option B: Groq (free, fast)
# GROQ_API_KEY=gsk_your-groq-key-here

# Option C: OpenRouter (access 100+ models, has free tier)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# ─────────────────────────────────────────────────────────────────────────────

JWT_SECRET=mathquest-super-secret-change-in-production
DATABASE_URL=./data/mathquest.db
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
